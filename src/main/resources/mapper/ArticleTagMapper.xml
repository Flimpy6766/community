<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.community.article.mapper.ArticleTagMapper">

    <select id="selectTagNamesByArticleIds"
            resultType="com.community.article.mapper.row.ArticleTagNameRow">
        SELECT at.article_id,
               t.name AS tag_name
        FROM article_tag at
        INNER JOIN tag t ON t.id = at.tag_id
        WHERE at.article_id IN
        <foreach collection="articleIds" item="articleId" open="(" separator="," close=")">
            #{articleId}
        </foreach>
        ORDER BY at.article_id, at.tag_id
    </select>

    <insert id="insertBatch">
        INSERT INTO article_tag (article_id, tag_id)
        VALUES
        <foreach collection="relations" item="relation" separator=",">
            (#{relation.articleId}, #{relation.tagId})
        </foreach>
    </insert>

</mapper>
