# Spring Boot
COMMUNITY_SERVER_PORT=8080
COMMUNITY_CORS_ALLOWED_ORIGINS=http://localhost:5173

# MySQL
COMMUNITY_DB_HOST=mysql-particle
COMMUNITY_DB_PORT=3306
COMMUNITY_DB_NAME=community
